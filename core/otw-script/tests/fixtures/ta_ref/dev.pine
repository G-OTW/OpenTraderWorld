//@version=6
// Reference: Pine Reference Manual, ta.dev; ta.cci = (src - sma) / (0.015 * dev).
indicator("ref dev")
pine_dev(source, length) =>
    mean = ta.sma(source, length)
    sum = 0.0
    for i = 0 to length - 1
        val = source[i]
        sum := sum + math.abs(val - mean)
    sum / length
plot(pine_dev(close, 20))
plot(ta.dev(close, 20))
plot((close - ta.sma(close, 20)) / (0.015 * pine_dev(close, 20)))
plot(ta.cci(close, 20))
