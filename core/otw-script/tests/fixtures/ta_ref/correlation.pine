//@version=6
// Reference: Pearson correlation over the window around ta.sma.
indicator("ref correlation")
pine_corr(a, b, len) =>
    ma = ta.sma(a, len)
    mb = ta.sma(b, len)
    float sab = 0.0
    float saa = 0.0
    float sbb = 0.0
    for i = 0 to len - 1
        da = a[i] - ma
        db = b[i] - mb
        sab := sab + da * db
        saa := saa + da * da
        sbb := sbb + db * db
    sab / math.sqrt(saa * sbb)
plot(pine_corr(close, open, 20))
plot(ta.correlation(close, open, 20))
