# Demo sandbox env — every value here is THROWAWAY. Never copy anything from deploy/.env.
#   cp demo.env.example .env && edit     (compose auto-loads deploy/demo/.env)

# Postgres password for the demo stack only (generate: openssl rand -hex 24).
POSTGRES_PASSWORD=

# AEAD master key for secrets at rest — the demo stores no real secrets, but core
# requires one (generate: openssl rand -hex 32).
OTW_SECRET_KEY=

# OpenRouter API key from a DEDICATED account with ZERO purchased credits.
# Free models (ids ending in `:free`) work; paid models 402. Leave empty to run the
# demo without the AI agent.
OTW_DEMO_LLM_KEY=

# AlphaVantage API key for the seeded "Market news" feed (free tier at
# alphavantage.co/support/#api-key). Read only by `--seed-demo`, which seals it into
# feed_secrets — it is never stored in the seed SQL or the repo. Leave empty to keep
# that one feed disabled; the Reuters/Fed/ECB RSS feeds need no credential.
# The free tier allows 25 requests/day, so the feed polls hourly.
OTW_DEMO_AV_KEY=

# ── Public hosting (leave every line unset for a local plain-HTTP test) ──
# Released image tags to run instead of `latest` — pin these in production, otherwise
# a rebuild silently changes what runs and rollback-by-tag does not work. The tag must
# exist on Docker Hub (published by the release-images workflow).
# OTW_IMAGE_TAG=0.0.6
#
# Public hostname, and the Caddy site address. Set it and Caddy issues a Let's Encrypt
# certificate over HTTP-01 on first request — so DNS must already resolve to this host
# and port 80 must be reachable from the internet.
# OTW_DOMAIN=demo.example.com
#
# Only when something else terminates TLS in front (CDN/proxy): serve a preissued origin
# keypair from ./certs/origin.pem + origin.key instead of using ACME.
# OTW_CADDYFILE=./Caddyfile.demo
#
# Bind the published ports to one address — e.g. a tailnet IP while staging, so the demo
# is not publicly reachable until you choose to open it.
# OTW_DEMO_BIND=0.0.0.0
# OTW_DEMO_PORT=80
# OTW_DEMO_HTTPS_PORT=443

# OTW_LOG=info
